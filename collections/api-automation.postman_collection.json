  "item": [
    {
      "name": "Users",
      "item": [
        {
          "name": "GET - Obtener usuarios",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Response is JSON\", function () {\r",
                  "    pm.response.to.be.json;\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Users list exists\", function () {\r",
                  "    let data = pm.response.json();\r",
                  "    pm.expect(data.length).to.be.above(0);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Name is valid\", function () {\r",
                  "   let users = pm.response.json();\r",
                  "   pm.expect(users[0]).to.have.property(\"name\");\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Username is valid\", function () {\r",
                  "   let users = pm.response.json();\r",
                  "   pm.expect(users[0]).to.have.property(\"username\");\r",
                  "});\r",
                  "\r",
                  "\r",
                  "\r",
                  "\r",
                  "\r",
                  ""
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users"
              ]
            }
          },
          "response": []
        },
        {
          "name": "GET - Obtener usuario por ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Validate user id\", function () {\r",
                  "    let user = pm.response.json();\r",
                  "    pm.expect(user.id).to.eql(1);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Email is valid\", function () {\r",
                  "    let email = pm.response.json().email;\r",
                  "    pm.expect(email).to.match(/@/);\r",
                  "});\r",
                  "\r",
                  "\r",
